FROM python:3.14-slim@sha256:af30dd6e5f99a127a05c5c1189f0f454b389c87d6ad9ffbab7a8cef12d3852e5

RUN apt-get update && apt-get install -y --no-install-recommends \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.21 /uv /uvx /bin/
ENV UV_MALWARE_CHECK=1
ENV UV_SYSTEM_PYTHON=1

WORKDIR /app

COPY pyproject.toml /app/pyproject.toml
COPY uv.lock /app/uv.lock

RUN uv sync --frozen

COPY tests /app/tests
COPY testcfg /app/testcfg
COPY opgincidentresponse /app/opgincidentresponse
COPY response /app/response
COPY pytest.ini /app/pytest.ini
COPY manage.py /app/manage.py

CMD ["uv", "run", "pytest"]
