FROM node:lts-alpine3.23@sha256:0468540aa58203ff9e40c2aab3907c52644ab818af6176b1c70a026137dc92a2 AS asset-env

WORKDIR /app

COPY nginx/assets .

RUN npm ci --ignore-scripts && npm run build

#pinned to known working older sha version
FROM python:3.14-slim@sha256:82abc9f53600280b0757126f83c5a7d47088592d2acb6b4c0b9e97f76865508c

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /bin/
ENV UV_MALWARE_CHECK=1
ENV UV_SYSTEM_PYTHON=1

WORKDIR /app

COPY pyproject.toml /app/pyproject.toml
COPY uv.lock /app/uv.lock

#pinned to known working version
RUN uv sync --frozen --no-dev

COPY opgincidentresponse /app/opgincidentresponse
COPY response /app/response
COPY startup.sh /app/startup.sh
COPY --from=asset-env /app/dist /app/opgincidentresponse/static
COPY manage.py /app/manage.py

VOLUME ["/app/opgincidentresponse/static"]

CMD ["bash", "/app/startup.sh"]
