FROM node:lts-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS asset-env

WORKDIR /app

COPY nginx/assets .

RUN yarn  --immutable --frozen-lockfile --ignore-scripts && yarn build

#pinned to known working older sha version
FROM python:3.14-slim@sha256:cea0e6040540fb2b965b6e7fb5ffa00871e632eef63719f0ea54bca189ce14a6

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.2@sha256:d0a0a753ab981624b49c97abc98821c1c09f4ca69d1ef5cee69c501be3d88479 /uv /uvx /bin/
ENV UV_MALWARE_CHECK=1
ENV UV_SYSTEM_PYTHON=1

WORKDIR /app

COPY pyproject.toml /app/pyproject.toml
COPY uv.lock /app/uv.lock

#pinned to known working version
RUN uv sync --frozen --no-dev

COPY opgincidentresponse /app/opgincidentresponse
COPY response /app/response
COPY startup.sh /app/startup.sh
COPY --from=asset-env /app/dist /app/opgincidentresponse/static
COPY manage.py /app/manage.py

VOLUME ["/app/opgincidentresponse/static"]

CMD ["bash", "/app/startup.sh"]
